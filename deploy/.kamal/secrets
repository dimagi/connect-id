# Secrets for Kamal, read by `kamal deploy` from the deploy/ directory.
# This file is committed: it holds commands that fetch secrets, never the values themselves.
# See https://kamal-deploy.org/docs/configuration/environment-variables/#secrets

# ECR login token. In CI the AWS credentials come from the github_deploy role (OIDC).
# Running locally (only for the one-off `kamal upgrade`), set AWS_PROFILE and `aws sso login` first.
KAMAL_REGISTRY_PASSWORD=$(aws ecr get-login-password --region us-east-1)

# The app's secrets: one JSON secret in AWS Secrets Manager, one key per env var, fetched once per deploy.
# Every key below must also be listed under env.secret in config/deploy.yml, and exist in the secret
# (deploy/tests/test_production_secret.py checks the first, the pre-deploy hook the second).
# Store values with bin/production_secret.py, not by hand: Kamal changes some characters on the way to the
# container, and the script stores them so that they come out unchanged. See README, "Production Deploy".
SECRETS=$(kamal secrets fetch --adapter aws_secrets_manager connect-id/production)
SECRET_KEY=$(kamal secrets extract SECRET_KEY ${SECRETS})
DATABASE_URL=$(kamal secrets extract DATABASE_URL ${SECRETS})
CELERY_BROKER_URL=$(kamal secrets extract CELERY_BROKER_URL ${SECRETS})
TWILIO_ACCOUNT_SID=$(kamal secrets extract TWILIO_ACCOUNT_SID ${SECRETS})
TWILIO_AUTH_TOKEN=$(kamal secrets extract TWILIO_AUTH_TOKEN ${SECRETS})
FCM_PRIVATE_KEY=$(kamal secrets extract FCM_PRIVATE_KEY ${SECRETS})
FCM_PRIVATE_KEY_ID=$(kamal secrets extract FCM_PRIVATE_KEY_ID ${SECRETS})
GOOGLE_PRIVATE_KEY=$(kamal secrets extract GOOGLE_PRIVATE_KEY ${SECRETS})
GOOGLE_PRIVATE_KEY_ID=$(kamal secrets extract GOOGLE_PRIVATE_KEY_ID ${SECRETS})
OIDC_RSA_PRIVATE_KEY=$(kamal secrets extract OIDC_RSA_PRIVATE_KEY ${SECRETS})
BIGQUERY_GOOGLE_CREDENTIALS_JSON=$(kamal secrets extract BIGQUERY_GOOGLE_CREDENTIALS_JSON ${SECRETS})
OCS_API_KEY=$(kamal secrets extract OCS_API_KEY ${SECRETS})
GA_API_SECRET=$(kamal secrets extract GA_API_SECRET ${SECRETS})
SUPERSET_UPLOAD_PASSWORD=$(kamal secrets extract SUPERSET_UPLOAD_PASSWORD ${SECRETS})
COMMCARE_CONNECT_CLIENT_SECRET=$(kamal secrets extract COMMCARE_CONNECT_CLIENT_SECRET ${SECRETS})
MAPBOX_ACCESS_TOKEN=$(kamal secrets extract MAPBOX_ACCESS_TOKEN ${SECRETS})
SENTRY_DSN=$(kamal secrets extract SENTRY_DSN ${SECRETS})
HEALTH_CHECK_TOKENS=$(kamal secrets extract HEALTH_CHECK_TOKENS ${SECRETS})
