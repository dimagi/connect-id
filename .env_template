# Required for local development. Defaults match the services in docker-compose.yml.
SECRET_KEY=django-insecure-local-dev-only-do-not-use-in-production
DEBUG=True
DATABASE_URL=postgres://connect:connect@localhost:5433/connect
CELERY_BROKER_URL=redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# Everything below is optional: settings.py supplies a default for each one.
# Uncomment and set only what you need. Leaving a key present but empty can
# break startup, since an empty value overrides the default rather than
# falling back to it.

# DJANGO_ALLOWED_HOSTS=
# CSRF_TRUSTED_ORIGINS=

# TWILIO_ACCOUNT_SID=
